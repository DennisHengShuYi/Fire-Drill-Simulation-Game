[node name="Movement" type="Label" parent="TutorialPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "🎮 CONTROLS:
• WASD keys to move around.
• Mouse to look around.
• Crouch (C or Ctrl) to stay low."
autowrap_mode = 2

[node name="Rule1" type="Label" parent="TutorialPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "🚪 1. FEEL DOORS (Press F)
Never open a door without feeling the door or its handle first. If it is hot, there is a fire on the other side. Opening it feeds oxygen to the fire, causing a deadly explosion/backdraft!"
autowrap_mode = 2

[node name="Rule2" type="Label" parent="TutorialPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "💨 2. STAY LOW (Hold C or Ctrl)
Smoke rises to the ceiling and contains toxic gases. When walking through hallways filled with smoke, you MUST crouch. If you stand upright, you will suffocate!"
autowrap_mode = 2

[node name="Rule3" type="Label" parent="TutorialPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "🛗 3. NEVER USE LIFTS
During a fire, lifts can lose power, trapping you inside, while the shaft acts like a chimney. Always look for the green Fire Exit door and use the stairs!"
autowrap_mode = 2

[node name="Rule4" type="Label" parent="TutorialPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "📞 4. DIAL 999
Once you have safely reached the outside assembly point, immediately dial 999 to alert the fire department."
autowrap_mode = 2

